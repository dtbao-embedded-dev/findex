{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Findex",
  "version": "../package.json",
  "identifier": "com.dtbao.findex",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1832",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Findex",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Findex",
        "width": 360,
        "height": 280,
        "center": true,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 dtbao",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMUMyNjNDQjMyMDIyMkMKUldRc0lpQ3pQQ1ljb3h2ZTdHYzlxd1pGYXpuSndsbkJER0NibFpKdS9TcHZ2SElzZWdjV1llNDIK",
      "endpoints": [
        "https://github.com/dtbao-embedded-dev/findex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
